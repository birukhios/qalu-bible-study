rules_version = '2';
// Each signed-in person can read and write only their own document, users/<their Firebase user id>,
// which holds two fields: data (the account's notes, highlights and Journey progress) and updated.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }
  }
}
